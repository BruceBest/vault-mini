[Unit]
Description=VaultMini - Minimal Vaultwarden Frontend
After=network.target docker.service

[Service]
Type=simple
User=bruce
WorkingDirectory=/home/bruce/vault-mini
ExecStart=/home/bruce/.hermes/hermes-agent/venv/bin/python3 /home/bruce/vault-mini/server.py 8090
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
