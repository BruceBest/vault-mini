[Unit]
Description=VaultMini - Minimal Vaultwarden Frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# User service: clone into ~/vault-mini and create its .venv first.
WorkingDirectory=%h/vault-mini
EnvironmentFile=%h/.config/vault-mini/config.env
ExecStart=%h/vault-mini/run.sh
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
