# systemd EnvironmentFile syntax. No master password or session key belongs here.
VAULT_URL=https://your-vault.example.com
# Set an absolute path: user systemd may not share your interactive shell PATH.
BW_PATH=/absolute/path/to/bw
# Empty for a dedicated hostname, /mini for a shared hostname/subpath.
BASE_PATH=/mini
HOST=127.0.0.1
PORT=8090
